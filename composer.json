            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "vittascience/vtuser": "1.4.3",
        "vittascience/vtinterfaces": "1.5.12",
        "vittascience/vtclassroom": "1.4.9",
        "vittascience/vtlearn": "1.5.2",
        "vittascience/vutils": "1.4.2",
        "symfony/var-dumper": "^7.4"
    },
    "require": {
        "doctrine/orm": "^2.6.2",
        "symfony/yaml": "^7.4",
        "mikey179/vfsstream": "^1.6.8",
        "monolog/monolog": "^3.7",
        "chriskonnertz/bbcode": "^1.1",
        "phpmailer/phpmailer": "^7.0",
        "aiken/i18next": "dev-master",
        "vlucas/phpdotenv": "^5.6",
        "google/apiclient": "^2.19.4",
        "firebase/php-jwt": "^7.0",
        "jasig/phpcas": "^1.3",
        "guzzlehttp/guzzle": "^7.5",
        "symfony/cache": "^7.4",
        "doctrine/annotations": "^2.0",
        "phpseclib/phpseclib": "~2.0",
        "php-opencloud/openstack": "^3.2",
        "league/oauth2-google": "^4.0",
        "codercat/jwk-to-pem": "^1.0"
